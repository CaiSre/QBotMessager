# 复制为 .env 后按需修改。docker compose 会自动读取同目录的 .env。
#
# 对外地址、会话、限速、QQ 推送参数等非敏感配置已改为数据库持久化，
# 登录后在「系统设置」页面修改即可，重建容器无需再提供。
# 下方注释掉的环境变量仅在首次启动、库内尚无对应设置时作为初始值导入。

# ---------------- 数据库（docker compose 使用）----------------
MYSQL_PASSWORD=请替换为强密码
MYSQL_ROOT_PASSWORD=请替换为强密码

# 单独 docker run 时需自行提供连接串；compose 会覆盖为 db 服务地址
# sqlx 的 MySQL URL 协议前缀是 mysql://
# MYSQL_URL=mysql://qbotmessager:密码@db:3306/qbotmessager

# ---------------- 安全 ----------------
# Fernet 主密钥，用于加密库内 AppSecret。生成方式：
#   openssl rand -base64 32 | tr '+/' '-_'
# 必填：留空时启动失败。仅本地调试可显式设置 ALLOW_PLAINTEXT_SECRETS=true
# 允许敏感字段降级明文；该密钥必须保留在环境变量中。
APP_SECRET_KEY=
ALLOW_PLAINTEXT_SECRETS=false

# ---------------- 初始超级管理员（首次启动创建，之后可删除）----------------
# 密码必须满足登录密码策略（8~256 位）。账号已存在时，只有密码与
# BOOTSTRAP_ADMIN_PASSWORD 匹配且系统没有启用的超管，才会提升该账号。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------- QQ 机器人（首次启动导入，之后以库内机器人为准）----------------
QQ_APPID=
QQ_APP_SECRET=
# 支持多个：OPENID=['openid1', 'openid2']
OPENID=

# ---------------- 已迁移到「系统设置」----------------
# 首次启动会导入数据库，之后修改请到系统设置页面。如需沿用旧值可取消注释：
# PUBLIC_BASE_URL=http://localhost:3000
# TIMEZONE=
# LOG_LEVEL=INFO
# MAX_BODY_BYTES=65536
# GITHUB_MAX_BODY_BYTES=2097152
# WEBHOOK_ALLOW_QUERY_TOKEN=false
# REGISTER_ENABLED=false
# SESSION_TTL_HOURS=72
# COOKIE_SECURE=false
# RP_ID=localhost
# RP_NAME=QQ Bot for Message Server
# LOGIN_MAX_FAILURES=5
# LOGIN_IP_MAX_FAILURES=30
# LOGIN_WINDOW_SECONDS=900
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TIMEOUT=15
# EMAIL_CODE_TTL_MINUTES=10
# EMAIL_CODE_RESEND_SECONDS=60
# EMAIL_CODE_HOURLY_LIMIT=5
# EMAIL_CODE_IP_HOURLY_LIMIT=30
# QQ_HOST=https://api.bot.qq.com
# QQ_QPS=5
# QQ_QPM=30
# QQ_MIN_INTERVAL=0.21
# MARKDOWN_MAX_LEN=4000
# TEXT_MAX_LEN=2000

# ---------------- 反向代理与静态资源 ----------------
# 是否信任上游反向代理传来的 X-Forwarded-For。
# 直连部署（无反向代理）保持 false；由 Nginx/Caddy 等代理转发时设为 true，
# 此时取 X-Forwarded-For 最右侧一跳作为客户端 IP（伪造头只影响最左一跳）。
TRUST_PROXY=false
# 推送队列总积压上限与单用户积压上限；单用户额度避免一个账号占满队列。
PUSH_QUEUE_MAX=200
PUSH_QUEUE_MAX_PER_USER=20

# ---------------- 数据保留 ----------------
# 后台每小时/每天清理过期数据；天数设为 0 可关闭对应表的清理。
# 推送日志超过 90 天删除，内容预览超过 7 天单独清空，兼顾排查与隐私。
RETENTION_SESSIONS_DAYS=30
RETENTION_EMAIL_CODES_DAYS=7
RETENTION_EMAIL_GUARDS_DAYS=7
RETENTION_AUDIT_DAYS=180
RETENTION_PUSH_LOGS_DAYS=90
RETENTION_PUSH_PREVIEW_DAYS=7
RETENTION_INTERVAL_HOURS=24
# 前端静态产物目录，容器内默认为 /app/web；本地直跑 Rust 时指向 web/out
STATIC_DIR=./web/out

# ---------------- 构建与端口 ----------------
APP_PORT=3000
# WORKERS：Actix worker 数，可选；缺省为 CPU 核数且最多 2（降低容器内存占用）
# WORKERS=2
