# 复制为 .env 后按需修改。docker compose 会自动读取同目录的 .env。
#
# 对外地址、会话、限速、QQ 推送参数等非敏感配置已改为数据库持久化，
# 登录后在「系统设置」页面修改即可，重建容器无需再提供。
# 下方注释掉的环境变量仅在首次启动、库内尚无对应设置时作为初始值导入。

# ---------------- 数据库（docker compose 使用）----------------
MYSQL_PASSWORD=请替换为强密码
MYSQL_ROOT_PASSWORD=请替换为强密码

# 单独 docker run 时需自行提供连接串；compose 会覆盖为 db 服务地址
# MYSQL_URL=mysql+asyncmy://qbotmessager:密码@db:3306/qbotmessager

# ---------------- 安全 ----------------
# Fernet 主密钥，用于加密库内 AppSecret。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时敏感字段降级为明文并告警，生产环境务必设置；该密钥必须保留在环境变量中。
APP_SECRET_KEY=

# ---------------- 初始超级管理员（首次启动创建，之后可删除）----------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------- QQ 机器人（首次启动导入，之后以库内机器人为准）----------------
QQ_APPID=
QQ_APP_SECRET=
# 支持多个：OPENID=['openid1', 'openid2']
OPENID=

# ---------------- 已迁移到「系统设置」----------------
# 首次启动会导入数据库，之后修改请到系统设置页面。如需沿用旧值可取消注释：
# PUBLIC_BASE_URL=http://localhost:3000
# TIMEZONE=
# LOG_LEVEL=INFO
# MAX_BODY_BYTES=65536
# WEBHOOK_ALLOW_QUERY_TOKEN=false
# REGISTER_ENABLED=false
# SESSION_TTL_HOURS=72
# COOKIE_SECURE=false
# RP_ID=localhost
# RP_NAME=QQ Bot for Message Server
# LOGIN_MAX_FAILURES=5
# LOGIN_IP_MAX_FAILURES=30
# LOGIN_WINDOW_SECONDS=900
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TIMEOUT=15
# EMAIL_CODE_TTL_MINUTES=10
# EMAIL_CODE_RESEND_SECONDS=60
# EMAIL_CODE_HOURLY_LIMIT=5
# QQ_HOST=https://api.bot.qq.com
# QQ_QPS=5
# QQ_QPM=30
# QQ_MIN_INTERVAL=0.21
# MARKDOWN_MAX_LEN=4000
# TEXT_MAX_LEN=2000

# ---------------- 构建与端口 ----------------
# 国内网络可改为镜像源，例如：
#   PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple
#   NPM_MIRROR=https://registry.npmmirror.com
PYPI_MIRROR=https://pypi.org/simple
NPM_MIRROR=https://registry.npmjs.org
APP_PORT=3000
